{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // ONE-STOP FULL-STACK LAUNCH (ADR-0071). Starts the .NET Aspire AppHost, which orchestrates the whole local
      // stack as one resource graph: the Playground OP host ("api"), the interactive-login build-watcher ("auth"),
      // and the Management console Vite dev server ("mgmt"). Aspire gates each UI resource on the API being HEALTHY
      // (WaitFor + /health), deterministically eliminating the old UI-before-API race, and the Aspire dashboard is the
      // single place for ordered startup, logs, and traces. Prerequisite: run `pnpm install` once under src/frontend
      // (Node via NVS — `nvs add 22`). The dashboard URL is printed on startup.
      "name": "Aspire: Full stack (F5)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/NCode.Identity.OpenId.Playground.AppHost/NCode.Identity.OpenId.Playground.AppHost.csproj",
      "launchSettingsProfile": "https",
      "presentation": {
        "group": "0-fullstack",
        "order": 1
      }
    },
    {
      // Debug ONLY the Playground OP host, without the frontend apps or Aspire orchestration.
      "name": "C#: NCode.Identity.OpenId.Playground Debug",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/NCode.Identity.OpenId.Playground/NCode.Identity.OpenId.Playground.csproj",
      "launchSettingsProfile": "NCode.Identity.OpenId.Playground",
      "justMyCode": true,
      "logging": {
        "moduleLoad": false
      }
    }
  ]
}
