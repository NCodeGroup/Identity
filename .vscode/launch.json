{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: NCode.Identity.OpenId.Playground Debug",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/NCode.Identity.OpenId.Playground/NCode.Identity.OpenId.Playground.csproj",
      "launchSettingsProfile": "NCode.Identity.OpenId.Playground",
      "justMyCode": true,
      "logging": {
        "moduleLoad": false
      }
    },
    {
      // Starts the ENTIRE frontend stack (every Vite app) via build/dev-ui.ps1, which runs
      // `pnpm dev` (turbo run dev) and puts the NVS-managed Node 22 on PATH. js-debug auto-attaches
      // to the spawned node processes, and serverReadyAction opens the browser once a Vite dev
      // server (e.g. the mgmt app) prints its local URL. Backend-served bundles (apps/auth) are
      // build-watched into their `dist`, which the Playground serves.
      "name": "UI: Frontend dev (all surfaces)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -File \"${workspaceFolder}/build/dev-ui.ps1\"",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "API + UI (F5)",
      "configurations": [
        "C#: NCode.Identity.OpenId.Playground Debug",
        "UI: Frontend dev (all surfaces)"
      ],
      "stopAll": true,
      "presentation": {
        "group": "0-fullstack",
        "order": 1
      }
    }
  ]
}
