{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // ONE-STOP FULL-STACK LAUNCH (ADR-0071). Starts the .NET Aspire AppHost, which orchestrates the whole local
      // stack as one resource graph: the OpenID host ("api"), the interactive-login build-watcher ("auth"),
      // and the Management console Vite dev server ("mgmt"). Aspire gates each UI resource on the API being HEALTHY
      // (WaitFor + /health), deterministically eliminating the old UI-before-API race, and the Aspire dashboard is the
      // single place for ordered startup, logs, and traces. Prerequisite: run build/frontend-install.ps1 once per clone
      // (it adds the Node pinned in src/frontend/.node-version through NVS, the pinned pnpm, and the pnpm workspace).
      // The dashboard URL is printed on startup.
      //
      // DEBUGGER GOTCHA: keep "User-Unhandled Exceptions" OFF in the Run and Debug > BREAKPOINTS panel. Benign
      // request-abort cancellations (e.g. a SPA cancelling an in-flight discovery fetch under React StrictMode) throw
      // OperationCanceledException; pausing on them freezes the process long enough for the Npgsql connection to time
      // out, which cascades into a dead connection pool where every subsequent request fails. This breakpoint setting
      // is separate from "justMyCode" below.
      "name": "Aspire: Full stack (F5)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/NCode.Identity.OpenId.LocalDev/NCode.Identity.OpenId.LocalDev.csproj",
      "launchSettingsProfile": "https",
      // Step into framework code when debugging.
      "justMyCode": false,
      "presentation": {
        "group": "0-fullstack",
        "order": 1
      }
    },
    {
      // Debug ONLY the OpenID host, without the frontend apps or Aspire orchestration.
      "name": "C#: NCode.Identity.OpenId.Host Debug",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/NCode.Identity.OpenId.Host/NCode.Identity.OpenId.Host.csproj",
      "launchSettingsProfile": "NCode.Identity.OpenId.Host",
      // Step into framework code when debugging.
      "justMyCode": false,
      "logging": {
        "moduleLoad": false
      }
    }
  ]
}
