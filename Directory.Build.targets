<Project>
  <!-- These settings are gated on IsPackable. Test projects and the host projects set <IsPackable>false</IsPackable>
       in their body (visible here, since Directory.Build.targets is imported after the project body); shipping
       libraries leave it unset. The SDK defaults an unset IsPackable to 'true' only later in evaluation, so we gate
       on "not explicitly false" rather than "== true" — otherwise shipping projects (still empty here) are skipped. -->

  <!-- Packaging + provenance defaults for the shipping (non-test) assemblies. This is an open-source library
       published from a PUBLIC GitHub repo, so tracked source is served from github.com via SourceLink — we do
       NOT embed source in the PDB (no EmbedAllSources). EmbedUntrackedSources only pulls in generated files that
       have no URL (e.g. the Nerdbank.GitVersioning ThisAssembly file). A portable .snupkg carries the symbols. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Only untracked/generated files (no github.com URL) are embedded; tracked source resolves via SourceLink. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Pack on build: `dotnet build` (the DoD, CI, and local/IDE builds) emits each shippable .nupkg + .snupkg
         directly, so there is no separate pack step and all packages land in one folder for the publish job. -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)\README.md')"
      >README.md</PackageReadmeFile>
    <PackageTags>oauth;oauth2;oidc;openid-connect;jwt;jose;jws;jwe;jwk;identity;authentication;security</PackageTags>
    <PackageReleaseNotes>See the changelog: https://github.com/NCodeGroup/Identity/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Deterministic, source-linked builds to github.com so consumers can step into the exact released source. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Bans disallowed APIs (RS0030) on top of build/BannedSymbols.txt, which build/ProjectTemplate.props adds to every project: BannedSymbols.Encoding.txt in every project (ADR-1266), BannedSymbols.txt on shipping code only (ADR-1127). -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Encoding.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!-- Tracks the public API surface (RS0016/RS0017/RS0024): each packable project lists its surface in the sibling
       PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt (auto-registered as AdditionalFiles by the analyzer). A public
       change that isn't recorded fails the build. Pre-1.0: Shipped stays empty and the whole surface lives in
       Unshipped; move Unshipped -> Shipped at v1. See docs/api-compatibility.md. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- A shipping package never switches off its consumers' [LoggerMessage] generator. Microsoft.Extensions.Telemetry.Abstractions
       (a dependency of Microsoft.Extensions.Http.Resilience) sets DisableMicrosoftExtensionsLoggingSourceGenerator in every
       project that consumes it, directly or transitively, and replaces the generator with Microsoft.Gen.Logging, which
       generates a different logged-state type. See ADR-1385. -->
  <Target
    Name="RejectLoggingGeneratorReplacement"
    AfterTargets="ResolveReferences"
    Condition="'$(IsPackable)' != 'false'"
  >
    <ItemGroup>
      <_TelemetryAbstractionsAnalyzer
        Include="@(Analyzer)"
        Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.Extensions.Telemetry.Abstractions'"
      />
    </ItemGroup>
    <Error
      Condition="'$(DisableMicrosoftExtensionsLoggingSourceGenerator)' == 'true' Or '@(_TelemetryAbstractionsAnalyzer)' != ''"
      Text="A shipping package must not switch off the Microsoft.Extensions.Logging source generator: $(MSBuildProjectName) depends on Microsoft.Extensions.Telemetry.Abstractions or sets DisableMicrosoftExtensionsLoggingSourceGenerator, which replaces the [LoggerMessage] generator of every project that consumes the package. Bound outbound calls with Polly.Core instead of Microsoft.Extensions.Http.Resilience (ADR-1385)."
    />
  </Target>
</Project>
