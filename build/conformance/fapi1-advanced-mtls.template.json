{
  "comment:template": "Template for run-conformance.ps1 -Fapi1Advanced. The script adds each client's private 'jwks' and its 'mtls' certificate and key, generated at run time and never committed, and writes the result beside this file as fapi1-advanced-mtls.json (gitignored).",
  "description": "NCode.Identity OP \u2014 FAPI 1.0 Advanced Final (self_signed_tls_client_auth client authentication, pushed authorization requests, certificate-bound access tokens).",
  "alias": "ncode-fapi1-mtls",
  "server": {
    "discoveryUrl": "https://host.docker.internal:5001/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "fapi1-mtls",
    "scope": "openid"
  },
  "client2": {
    "client_id": "fapi1-mtls-2",
    "scope": "openid"
  },
  "resource": {
    "resourceUrl": "https://host.docker.internal:5001/oauth2/userinfo"
  },
  "browser": [
    {
      "match": "https://host.docker.internal:5001/oauth2/authorize*",
      "tasks": [
        {
          "task": "Login",
          "match": "https://host.docker.internal:5001/account/login*",
          "optional": true,
          "commands": [
            [
              "text",
              "id",
              "username",
              "conformance-user"
            ],
            [
              "text",
              "id",
              "password",
              "conformance-password"
            ],
            [
              "click",
              "id",
              "login"
            ]
          ]
        },
        {
          "task": "Consent",
          "match": "https://host.docker.internal:5001/account/consent*",
          "optional": true,
          "commands": [
            [
              "click",
              "id",
              "consent-allow"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "https://*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ]
}
