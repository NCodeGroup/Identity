{
  "comment:template": "Template for run-conformance.ps1 -Fapi1Advanced, rendered once per client-authentication method. The script replaces each {{token}} (issuer, alias, client_auth_method, client_id, client2_id), adds each client's private 'jwks' and its 'mtls' certificate and key, generated at run time and never committed, and writes the result beside this file as fapi1-advanced-<method>.json (gitignored).",
  "description": "NCode.Identity OP — FAPI 1.0 Advanced Final ({{client_auth_method}} client authentication, pushed authorization requests, certificate-bound access tokens).",
  "alias": "{{alias}}",
  "server": {
    "discoveryUrl": "{{issuer}}/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "{{client_id}}",
    "scope": "openid"
  },
  "client2": {
    "client_id": "{{client2_id}}",
    "scope": "openid"
  },
  "resource": {
    "resourceUrl": "{{issuer}}/oauth2/userinfo"
  },
  "browser": [
    {
      "match": "{{issuer}}/oauth2/authorize*",
      "tasks": [
        {
          "task": "Login",
          "match": "{{issuer}}/account/login*",
          "optional": true,
          "commands": [
            [
              "text",
              "id",
              "username",
              "conformance-user"
            ],
            [
              "text",
              "id",
              "password",
              "conformance-password"
            ],
            [
              "click",
              "id",
              "login"
            ]
          ]
        },
        {
          "task": "Consent",
          "match": "{{issuer}}/account/consent*",
          "optional": true,
          "commands": [
            [
              "click",
              "id",
              "consent-allow"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "https://*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ]
}
