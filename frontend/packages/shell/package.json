{
  "name": "@ncode/shell",
  "version": "0.0.0",
  "private": true,
  "description": "Stateful app-shell containers shared by the NCode.Identity frontend surfaces: the boot gate that loads a bundle's runtime configuration into the store and themes the app from its branding.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@ncode/config": "workspace:*",
    "@ncode/store": "workspace:*",
    "@ncode/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^9.5.0",
    "@ncode/test-support": "workspace:*",
    "@ncode/vite-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
