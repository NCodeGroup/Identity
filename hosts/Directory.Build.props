<Project>
  <!-- MSBuild uses the first Directory.Build.props found walking up, so explicitly import the
       repository-root one to inherit shared metadata, analyzers, and provenance settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The deployables: the reference hosts, their database and migration worker, and the local-dev AppHost. No package ships them, so nothing here packs (ADR-1501). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
