{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LocalDevelopment": {
    "Enabled": true
  },
  "OpenId": {
    "Platform": {
      "Settings": {
        "environment_type": "development"
      }
    }
  },
  "SecretProtection": {
    "RootKeyProvider": "ephemeral"
  },
  "ApiReference": {
    "DocumentEnabled": true,
    "PageEnabled": true
  },
  "Frontend": {
    "Branding": {
      "DisplayName": "NCode.Identity (dev)",
      "Mode": "light"
    },
    "Surfaces": {
      "playground": {
        "ClientId": "playground-spa",
        "Scopes": ["openid", "profile", "email", "offline_access"]
      },
      "conformance": {
        "ClientId": null
      }
    }
  },
  "DeveloperInteractiveSeed": {
    "TenantId": "default",
    "SpaClients": [
      {
        "ClientId": "playground-spa",
        "RedirectUris": [
          "https://localhost:5174/callback"
        ],
        "RequireConsent": true
      }
    ],
    "BffClients": [
      {
        "ClientId": "mgmt-console",
        "RedirectUris": [
          "https://localhost:5005/bff/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:5005/"
        ],
        "BackchannelLogoutUri": "https://localhost:5005/bff/backchannel-logout"
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5174",
      "https://localhost:5175",
      "http://localhost:4173",
      "https://localhost:4173"
    ]
  }
}
