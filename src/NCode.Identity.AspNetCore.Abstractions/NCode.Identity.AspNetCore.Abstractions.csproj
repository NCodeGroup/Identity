<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>NCode.Identity.AspNetCore</RootNamespace>
        <Description>The contracts of NCode.Identity's HTTP building blocks: the HTTP result executor and provider contracts, status-code and response-header support, HttpResultException, UriDescriptor and the front-channel endpoint metadata.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    </ItemGroup>
</Project>
