<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>NCode.Identity.Cose</RootNamespace>
        <Description>Opt-in CBOR Object Signing and Encryption (COSE, RFC 9052 / 9053) for NCode.Identity over System.Formats.Cbor: COSE_Sign1, COSE_Sign, COSE_Mac0, COSE_Mac, COSE_Encrypt0 and COSE_Encrypt with the family's JOSE algorithms and secret keys, and public COSE_Key and COSE_KeySet conversion.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NCode.Identity.Cose.Abstractions\NCode.Identity.Cose.Abstractions.csproj" />
        <ProjectReference Include="..\NCode.Identity.Jose.Abstractions\NCode.Identity.Jose.Abstractions.csproj" />
        <ProjectReference Include="..\NCode.Identity.Secrets.Abstractions\NCode.Identity.Secrets.Abstractions.csproj" />
        <ProjectReference Include="..\NCode.Identity.Registration\NCode.Identity.Registration.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="NCode.Base64Url" />
        <PackageReference Include="NCode.Buffers" />
        <PackageReference Include="System.Formats.Cbor" />
    </ItemGroup>
</Project>
