<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>NCode.Identity.Cryptography</RootNamespace>
        <Description>The default implementation of NCode.Identity's cryptography service and its Base64Url, Base64 and hexadecimal binary encoders.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NCode.Identity.Cryptography.Abstractions\NCode.Identity.Cryptography.Abstractions.csproj" />
        <ProjectReference Include="..\NCode.Identity.Registration\NCode.Identity.Registration.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
        <PackageReference Include="NCode.Base64Url" />
        <PackageReference Include="NCode.Buffers" />
        <PackageReference Include="NCode.Disposables" />
    </ItemGroup>
</Project>
