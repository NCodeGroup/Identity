{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Bff": {
    "Frontends": {
      "mgmt": {
        "ClientId": "mgmt-console",
        "ClientAuthentication": {
          "Method": "private_key_jwt",
          "KeyRing": "mgmt-client"
        },
        "Scopes": [ "profile", "email", "offline_access", "read:clients" ],
        "ReturnUrls": [ "/" ],
        "UserClaims": [ "preferred_username", "email" ],
        "UserInfo": {
          "Load": true
        },
        "DPoP": {
          "Mode": "required",
          "KeyRing": "mgmt-dpop"
        },
        "Jwks": {
          "Enabled": true
        }
      }
    }
  }
}
