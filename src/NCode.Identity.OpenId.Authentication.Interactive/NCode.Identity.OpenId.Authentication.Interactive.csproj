<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>NCode.Identity.OpenId.Authentication.Interactive</RootNamespace>
        <!-- Opts out: RDG's generated form binding reads a form whose antiforgery validation failed and answers 500 where the runtime factory answers 400.
             Guarded by LocalAccountLifecycleTests.ChangePassword_WithoutTheAntiforgeryToken_ChangesNothing.
             See ADR-1262 and issue #186. -->
        <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <!-- Cookie scheme, antiforgery, static-file serving, and minimal-API endpoints. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NCode.Identity.AspNetCore\NCode.Identity.AspNetCore.csproj" />
        <ProjectReference Include="..\NCode.Identity.OpenId.Abstractions\NCode.Identity.OpenId.Abstractions.csproj" />
        <ProjectReference Include="..\NCode.Identity.OpenId.Authentication.Abstractions\NCode.Identity.OpenId.Authentication.Abstractions.csproj" />
        <ProjectReference Include="..\NCode.Identity.OpenId.Authentication.Interactive.Abstractions\NCode.Identity.OpenId.Authentication.Interactive.Abstractions.csproj" />
        <ProjectReference Include="..\NCode.Identity.Registration.AspNetCore\NCode.Identity.Registration.AspNetCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
        <PackageReference Include="NCode.Buffers" />
        <PackageReference Include="Nerdbank.Streams" />
    </ItemGroup>
</Project>
