{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OpenId": {
    "Platform": {
      "Settings": {
        "environment_type": "development"
      }
    }
  },
  "SecretProtection": {
    "RootKeyProvider": "ephemeral"
  },
  "Frontend": {
    "ClientId": "mgmt-spa",
    "Features": {
      "dcr": true
    },
    "Branding": {
      "DisplayName": "NCode.Identity (dev)",
      "Mode": "light"
    },
    "Surfaces": {
      "playground": {
        "ClientId": "playground-spa",
        "Scopes": ["openid", "profile", "email", "offline_access"]
      },
      "conformance": {
        "ClientId": null
      }
    }
  },
  "DeveloperInteractiveSeed": {
    "TenantId": "default",
    "SpaClients": [
      {
        "ClientId": "mgmt-spa",
        "RedirectUris": [
          "https://localhost:5173/callback"
        ]
      },
      {
        "ClientId": "playground-spa",
        "RedirectUris": [
          "https://localhost:5174/callback"
        ],
        "RequireConsent": true
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "https://localhost:5174",
      "https://localhost:5175",
      "http://localhost:4173",
      "https://localhost:4173"
    ]
  }
}
