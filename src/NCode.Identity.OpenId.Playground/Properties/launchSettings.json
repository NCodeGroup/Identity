{
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:54035",
      "sslPort": 44369
    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "launchUrl": "scalar/v1",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DeveloperKeys__Mode": "PersistentSigningKey",
        "BootstrapAdmin__ClientId": "bootstrap-admin",
        "BootstrapAdmin__ClientSecret": "bootstrap-dev-secret"
      }
    },
    "NCode.Identity.OpenId.Playground": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "scalar/v1",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ReadyToRun": "0",
        "DeveloperKeys__Mode": "PersistentSigningKey",
        "BootstrapAdmin__ClientId": "bootstrap-admin",
        "BootstrapAdmin__ClientSecret": "bootstrap-dev-secret"
      },
      "dotnetRunMessages": "true",
      "applicationUrl": "https://localhost:5001;http://localhost:5000"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/scalar/v1",
      "publishAllPorts": true,
      "useSSL": true
    }
  }
}
