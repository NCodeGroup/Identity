{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "OpenId": {
    "Server": {
      "Settings": {
        "grant_types_supported": [
          "authorization_code",
          "implicit",
          "refresh_token",
          "client_credentials"
        ]
      }
    },
    "Tenant": {
      "Mode": "StaticSingle",
      "StaticSingle": {
        "TenantPath": "/"
      }
    }
  }
}
