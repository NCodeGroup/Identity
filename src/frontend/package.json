{
  "name": "@ncode/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "NCode.Identity frontend presentation platform (monorepo). See docs/adr/0064.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:report": "turbo run test --continue=always -- --coverage --coverage.reporter=cobertura --coverage.reporter=html --coverage.reporter=text-summary --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run storybook",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
