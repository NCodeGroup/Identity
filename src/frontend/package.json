{
  "name": "@ncode/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "NCode.Identity frontend presentation platform (monorepo). See docs/adr/0064.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:report": "turbo run test --continue=always -- --coverage --coverage.reporter=cobertura --coverage.reporter=html --coverage.reporter=text-summary --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run storybook",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\""
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.3.3",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
