{
  "name": "@ncode/test-support",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vitest support for NCode.Identity frontend workspaces: the console guard that fails any test which logs a warning or an error.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
