@page "/wasm"
@rendermode InteractiveWebAssembly
@inject IHttpClientFactory HttpClientFactory

<AuthorizeView>
    <Authorized>
        <span id="wasm-user">@context.User.FindFirst("email")?.Value</span>
    </Authorized>
    <NotAuthorized>
        <span id="wasm-user">signed out</span>
    </NotAuthorized>
</AuthorizeView>

@if (Api is not null)
{
    <span id="wasm-api">@Api</span>
}

@code {
    public const string ApiClientName = "api";

    private string? Api { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || RendererInfo.Name != "WebAssembly")
        {
            return;
        }

        var client = HttpClientFactory.CreateClient(ApiClientName);
        var response = await client.GetAsync("api/me");
        Api = $"{(int)response.StatusCode}:{await response.Content.ReadAsStringAsync()}";
        StateHasChanged();
    }
}
