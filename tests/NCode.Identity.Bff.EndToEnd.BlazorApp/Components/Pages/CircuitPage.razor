@page "/circuit"
@rendermode InteractiveServer

<AuthorizeView>
    <Authorized>
        <span id="circuit-user">@context.User.FindFirst("email")?.Value</span>
    </Authorized>
    <NotAuthorized>
        <span id="circuit-user">signed out</span>
    </NotAuthorized>
</AuthorizeView>

<span id="circuit-state">@(RendererInfo.IsInteractive ? "interactive" : "static")</span>
<button id="circuit-ping" @onclick="Ping">ping</button>
<span id="circuit-pings">@Pings</span>

@code {
    private int Pings { get; set; }

    private void Ping() => Pings++;
}
