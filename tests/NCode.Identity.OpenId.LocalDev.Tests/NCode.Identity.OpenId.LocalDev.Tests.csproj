<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>NCode.Identity.OpenId.LocalDev.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <PackageReference Include="NCode.Buffers" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- The fixture shared with build/tests/conformance-seed-credentials.tests.ps1, and the reference host's
             conformance overlay whose secret-authenticated clients ConformanceSeedSecrets lists. -->
        <None
            Update="DevelopmentSecrets\conformance-seed-golden.json"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\src\NCode.Identity.OpenId.Host\appsettings.Conformance.json"
            Link="DevelopmentSecrets\appsettings.Conformance.json"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\NCode.Identity.OpenId.LocalDev\NCode.Identity.OpenId.LocalDev.csproj" />
    </ItemGroup>
</Project>
